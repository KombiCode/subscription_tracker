<!-- app/views/dashboard/index.html.erb -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-gray-500 text-sm">Monthly Burn</h3>
    <p class="text-3xl font-bold"><%= number_to_currency(@total_monthly) %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-gray-500 text-sm">Active Subscriptions</h3>
    <p class="text-3xl font-bold"><%= @subscriptions.count %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-red-500 text-sm">Renewing in 30 Days</h3>
    <p class="text-3xl font-bold"><%= @renewing_soon.count %></p>
  </div>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="w-full text-left">
    <thead class="bg-gray-50">
      <tr>
        <th class="p-4">Service</th>
        <th class="p-4">Provider</th>
        <th class="p-4">Monthly</th>
        <th class="p-4">Next Renewal</th>
        <th class="p-4">MFA</th>
      </tr>
    </thead>
    <tbody>
      <% @subscriptions.each do |sub| %>
        <tr class="border-t">
          <td class="p-4 font-medium"><%= link_to sub.name, sub %></td>
          <td class="p-4"><%= sub.provider.name %></td>
          <td class="p-4"><%= number_to_currency(sub.monthly_cost) %></td>
          <td class="p-4 <%= 'text-red-600 font-bold' if sub.next_renewal_on <= 30.days.from_now %>">
            <%= l sub.next_renewal_on, format: :short %>
          </td>
          <td class="p-4">
            <% if sub.mfa_enabled %>
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs">Yes</span>
            <% else %>
              <span class="bg-red-100 text-red-800 px-2 py-1 rounded text-xs">No</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>