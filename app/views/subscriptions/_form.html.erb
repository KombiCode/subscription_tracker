<%= form_with(model: subscription, class: "contents") do |form| %>
  <% if subscription.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(subscription.errors.count, "error") %> prohibited this subscription from being saved:</h2>

      <ul class="list-disc ml-6">
        <% subscription.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:name].none?, "border-red-400 focus:outline-red-600": subscription.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :provider_id %>
    <%= form.text_field :provider_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:provider_id].none?, "border-red-400 focus:outline-red-600": subscription.errors[:provider_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :category_id %>
    <%= form.text_field :category_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:category_id].none?, "border-red-400 focus:outline-red-600": subscription.errors[:category_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :billing_cycle %>
    <%= form.number_field :billing_cycle, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:billing_cycle].none?, "border-red-400 focus:outline-red-600": subscription.errors[:billing_cycle].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :monthly_cost %>
    <%= form.text_field :monthly_cost, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:monthly_cost].none?, "border-red-400 focus:outline-red-600": subscription.errors[:monthly_cost].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :currency %>
    <%= form.number_field :currency, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:currency].none?, "border-red-400 focus:outline-red-600": subscription.errors[:currency].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :next_renewal_on %>
    <%= form.date_field :next_renewal_on, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:next_renewal_on].none?, "border-red-400 focus:outline-red-600": subscription.errors[:next_renewal_on].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :account_email %>
    <%= form.text_field :account_email, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:account_email].none?, "border-red-400 focus:outline-red-600": subscription.errors[:account_email].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :mfa_enabled %>
    <%= form.checkbox :mfa_enabled, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": subscription.errors[:mfa_enabled].none?, "border-red-400 focus:outline-red-600": subscription.errors[:mfa_enabled].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :mfa_method %>
    <%= form.text_field :mfa_method, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:mfa_method].none?, "border-red-400 focus:outline-red-600": subscription.errors[:mfa_method].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :credentials_location %>
    <%= form.text_field :credentials_location, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:credentials_location].none?, "border-red-400 focus:outline-red-600": subscription.errors[:credentials_location].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :notes %>
    <%= form.textarea :notes, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:notes].none?, "border-red-400 focus:outline-red-600": subscription.errors[:notes].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :purpose %>
    <%= form.text_field :purpose, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": subscription.errors[:purpose].none?, "border-red-400 focus:outline-red-600": subscription.errors[:purpose].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
